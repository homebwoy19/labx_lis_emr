# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME="Foundation Lab LIS"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Platform (Super Admin) apex domain. Each laboratory is a tenant reached as a
# subdomain of this host (foundation.labx.com.ng), while labx.com.ng itself is
# the Super Admin platform. Tenant resolution (subdomain + custom domain) and the
# dynamic CORS allow-list both key off this value; any *.PLATFORM_DOMAIN origin
# and every ACTIVE custom domain are allowed automatically (no need to list them
# in CORS_ORIGINS). Must match the frontend's VITE_PLATFORM_DOMAIN. Defaults to
# labx.com.ng when unset.
PLATFORM_DOMAIN=labx.com.ng

# ============================================================
# Database (Supabase Postgres) — replace with your connection strings.
# DATABASE_URL uses the pooled (pgbouncer) port for the app runtime.
# DIRECT_URL uses the direct port for prisma migrate.
# ============================================================
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# ============================================================
# JWT / Auth
# ============================================================
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Inactivity session timeout (minutes)
SESSION_IDLE_TIMEOUT_MIN=15
# Max concurrent logged-in devices per user
MAX_ACTIVE_DEVICES=2
# Failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout duration (minutes)
LOCKOUT_DURATION_MIN=15
# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Refresh-cookie SameSite policy: strict | lax | none.
# Use "none" when the frontend (e.g. Vercel) and this API are on DIFFERENT sites;
# the browser then requires Secure=true as well (auto-forced when SameSite=none).
# For production cross-site hosting set: COOKIE_SAMESITE=none and COOKIE_SECURE=true,
# and add your Vercel origin to CORS_ORIGINS above.
COOKIE_SAMESITE=strict

# ============================================================
# Redis (cache + BullMQ queues)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# Supabase Storage
# ============================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=lab-documents

# ============================================================
# Email (SMTP via Nodemailer)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Foundation Lab <no-reply@foundationlab.com>"

# ============================================================
# Uploads
# ============================================================
MAX_UPLOAD_SIZE_MB=15

# ============================================================
# Seed credentials (REQUIRED to run `pnpm db:seed`)
# The seed has NO fallback/default credentials — set real values here (or in
# your host's env) before seeding. Rotate these; never commit real secrets.
# ============================================================
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SEED_PASSWORD=

# ============================================================
# Background Scheduler
# ============================================================
SCHEDULER_ENABLED=true
SCHEDULER_DRIVER=auto
SUBSCRIPTION_SCAN_INTERVAL_MINUTES=60
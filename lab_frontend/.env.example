# Base URL of the LIS backend API, INCLUDING the /api/v1 prefix.
#
# Local development (backend running on your machine):
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Production (separate-domain hosting): point this at your deployed backend, e.g.
# VITE_API_BASE_URL=https://api.your-lis-domain.com/api/v1
#
# Notes:
#   • This value is baked in at build time, so set it in the Vercel project's
#     Environment Variables and redeploy when it changes.
#   • The backend MUST list this frontend's origin in CORS_ORIGINS, and (for the
#     cross-site refresh cookie) run with COOKIE_SAMESITE=none and COOKIE_SECURE=true.

# Platform (Super Admin) apex domain. Laboratories are served as subdomains of
# this host (foundation.labx.com.ng) with labx.com.ng itself being the Super
# Admin platform; custom domains (foundationlab.com.ng) are also supported. The
# frontend uses this to decide, per host, whether the tenant comes from the
# subdomain/custom-domain (login at "/") or from the URL path ("/:slug").
#   • Baked in at build time — set it in Vercel and redeploy when it changes.
#   • Must match the backend's PLATFORM_DOMAIN.
#   • Defaults to labx.com.ng when unset.
VITE_PLATFORM_DOMAIN=labx.com.ng
